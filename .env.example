# 复制成 .env 再填。除了人设，其他都可以留空——缺什么，启动日志会说。

# ── 人设 ────────────────────────────────────────────────────────────
# 她是谁。数据按人设各自独立存放在 data/personas/<id>/，切这一行就换人。
PERSONA_PATH=config/personas/example_persona.yaml

# ── Claude（编排脑：决定这轮怎么接、捞哪些记忆、要不要查证）──────────
# 优先读本机 Claude Code 的登录态；没有就用 `lingxi login anthropic`，
# 或者直接给 key：
# ANTHROPIC_API_KEY=sk-ant-xxx

# ── Responder（对外说话那一句）─────────────────────────────────────
# 选哪家在人设 yaml 的 responder.provider，模型 id 在这里，不进仓库。
#   provider: "deepseek"（默认，模型留空即 deepseek-v4-flash）
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_RESPONDER_MODEL=deepseek-v4-flash
#   provider: "doubao"（复用下面的 ARK_API_KEY）
# DOUBAO_RESPONDER_MODEL=ep-xxxxxxxxxxxxx

# ── Embedding（语义检索：记忆、表情包、声线语料）────────────────────
# 接入点 ID 属于你自己的账号，所以没有可用的默认值。不填就退回关键词匹配，
# 启动日志会说清楚缺什么。
# ARK_API_KEY=<火山方舟 API key>
# EMBEDDING_MODEL=ep-xxxxxxxxxxxxx

# ── 飞书机器人（只有跑 lingxi-feishu 才需要）───────────────────────
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx

# ── 其他 ───────────────────────────────────────────────────────────
# MEMORY_DATA_DIR 会覆盖上面那套按人设分目录的规则，让所有人设共用一个目录。
# 只在测试或迁移旧数据时才打开它。
# MEMORY_DATA_DIR=./data/memory

LOG_LEVEL=INFO
